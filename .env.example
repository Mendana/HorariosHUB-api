# Observabilidad local (perfil "observability" de docker-compose.dev.yml).
# Comentadas por defecto: sin ellas el backend loguea en modo "pretty" en
# consola y no exporta trazas (comportamiento normal de `docker compose up`).
# Descomenta ambas para activar logs JSON (Loki) y trazas (Tempo) al levantar
# ese perfil: docker compose --profile observability up -d
# LOG_FORMAT=json
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
