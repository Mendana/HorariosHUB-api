  "query": "\n            SELECT\n                s.subject,\n                s.grp,\n                se.starts_at,\n                se.duration_min\n            FROM schedule s\n            JOIN sessions se\n            ON se.subject = s.subject AND se.grp = s.grp\n            WHERE s.user_id = $1\n            ",
