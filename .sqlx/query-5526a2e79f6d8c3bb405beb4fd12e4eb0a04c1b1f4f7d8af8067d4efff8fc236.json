  "db_name": "PostgreSQL",
  "query": "\n            UPDATE sessions SET\n                subject = COALESCE($2, subject),\n                grp = COALESCE($3, grp),\n                starts_at = COALESCE($4, starts_at),\n                duration_min = COALESCE($5, duration_min),\n                classroom = COALESCE($6, classroom),\n                is_overridden = true\n            WHERE id = $1\n            RETURNING\n                id,\n                subject,\n                grp,\n                starts_at,\n                duration_min,\n                classroom,\n                source AS \"source: SessionSource\",\n                created_by,\n                is_overridden\n            ",
