{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT sg.id, sg.subject, sg.grp, (s.user_id IS NOT NULL) AS \"selected!\"\n            FROM subject_groups sg\n            LEFT JOIN schedule s ON sg.subject = s.subject AND s.grp = sg.grp AND s.user_id = $1\n            ORDER BY sg.subject, sg.grp\n            ",
