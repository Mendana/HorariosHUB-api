{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                n.id,\n                n.user_id,\n                n.type as \"type: NotificationType\",\n                n.title,\n                n.body,\n                n.session_id,\n                n.proposal_id,\n                n.read,\n                n.created_at\n            FROM notifications n\n            WHERE n.user_id = $1\n              AND ($2::boolean IS NULL OR n.read = $2)\n            ORDER BY n.created_at DESC\n            OFFSET $3\n            LIMIT $4\n            ",
