{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT\n                        c.id,\n                        c.proposed_by,\n                        c.session_id,\n                        c.subject,\n                        c.grp,\n                        c.change_type    AS \"change_type: ChangeType\",\n                        c.change_status  AS \"change_status: ChangeStatus\",\n                        c.prev_starts_at,\n                        c.prev_duration,\n                        c.prev_classroom,\n                        c.new_starts_at,\n                        c.new_duration,\n                        c.new_classroom,\n                        c.proposed_at,\n                        u.email          AS author_email\n                    FROM changes c\n                    JOIN users u ON u.id = c.proposed_by\n                    ORDER BY c.proposed_at DESC\n                    OFFSET $1\n                    LIMIT $2\n                    ",
