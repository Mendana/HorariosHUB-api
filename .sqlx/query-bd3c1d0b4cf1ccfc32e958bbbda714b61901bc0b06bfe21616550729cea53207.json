{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            se.id,\n            s.subject,\n            s.grp AS \"group\",\n            se.starts_at,\n            se.duration_min,\n            se.classroom\n        FROM schedule s\n        JOIN sessions se\n        ON se.subject = s.subject\n        AND se.grp = s.grp\n        WHERE s.user_id = $1\n        AND se.starts_at >= $2\n        AND se.starts_at < $3\n        ",
